{
  "name": "salescout-intern-task",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "server:start": "node --import tsx server/index.ts",
    "server:dev": "tsx server/index.ts",
    "client:dev": "cd client && npm run dev",
    "client:install": "cd client && npm install"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0"
  },
  "dependencies": {
    "express": "^4.18.0",
    "@types/express": "^4.17.0"
  }
}
